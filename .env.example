# CloudGuardAI Environment Configuration (Example)
# Rename to .env for local development. Never commit real keys.

# Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
STORAGE_BACKEND=local       # 's3' or 'local'
DATABASE_BACKEND=sqlite     # 'dynamodb' or 'sqlite'
REMEDIATION_BACKEND=hybrid  # 'hybrid', 'bedrock', or 'deterministic'

# AWS Configuration (Leave blank to use Local Resilient Fallback Mode)
AWS_DEFAULT_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# AWS Resource Overrides (if deploying to real AWS)
# S3_BUCKET_NAME=cloudguardai-artifacts-us-east-1
# DYNAMODB_TABLE_NAME=cloudguardai_scans
