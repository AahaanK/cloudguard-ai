# CloudGuardAI - Enterprise Security .gitignore
# Strictly prevents secret leakage, local credentials, and transient build artifacts

# Secrets, Environment Files & Keys
.env
.env.*
!.env.example
*.pem
*.key
*.pkcs12
*.pfx
*.cert
*.crt
id_rsa*
id_ed25519*

# AWS & Cloud Provider Local Configs
.aws/
aws_credentials
credentials.json
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
.terraform/
.terraform.lock.hcl

# Local Storage, SQLite Databases & Uploaded Test Blueprints
storage/uploads/*
storage/reports/*
storage/*.db
storage/*.sqlite
storage/*.sqlite3
!storage/uploads/.gitkeep
!storage/reports/.gitkeep

# Python Runtime & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Logging & Telemetry
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor Configurations
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
